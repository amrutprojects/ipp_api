# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5101
LOG_LEVEL=info
# Origins of the portal (comma-separated), and its address in e-mail links
CORS_ORIGINS=http://localhost:5176
PORTAL_URL=http://localhost:5176
# Number of reverse proxies in front of the server
TRUST_PROXY=1
APP_TIMEZONE=Asia/Kolkata
# API documentation at /api/docs (default: on, except in production)
API_DOCS=

# PostgreSQL: its own database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ipp_app
DB_PASSWORD=CHANGE_ME
DB_NAME=ipp_backend
DB_SSL=false
DB_POOL_MAX=10

# Signs the sessions: at least 48 random characters, e.g. openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
SESSION_HOURS=12
BCRYPT_ROUNDS=12
# 32 random bytes each, base64: openssl rand -base64 32. They must NEVER change once students have registered:
# without them the stored Aadhaar numbers cannot be read or matched.
AADHAAR_DATA_KEY=
AADHAAR_INDEX_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Sign-up, OTP, sign-in and password requests per IP per window
AUTH_RATE_LIMIT_MAX=30

# Sign-up OTP: lifetime, and the wait before a new one (empty = the lifetime)
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=
# Local only: a fixed code, so no SMS is sent (e.g. 666666). It works only with NODE_ENV=development and the portal on
# localhost; staging and production ignore it and send a random code with the SMS settings below.
STATIC_OTP=
# SMS gateway. The message must be the DLT-registered template's text ({otp}, {seconds} or {minutes} for its variables).
SMS_API_URL=http://sms.happysms.in/api/sendhttp.php
SMS_AUTH_KEY=
SMS_SENDER=
SMS_DLT_TEMPLATE_ID=
SMS_ROUTE=4
SMS_COUNTRY=91
# SMS_OTP_MESSAGE=

# E-mail (password reset links). Empty host: development writes the link to the log, production answers 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Documents: local (STORAGE_DIR) or s3 (private bucket; without keys the server's instance role is used)
STORAGE_DRIVER=local
STORAGE_DIR=storage
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KEY_PREFIX=

# Contact shown to students until the panel's Settings set their own
SUPPORT_EMAIL=
SUPPORT_MOBILE=
# The first Auditor (ADMIN) account, created by "npm run db:seed" when both are set; never overwritten
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=
